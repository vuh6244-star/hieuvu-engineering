---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { localize, stripLang, useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  /** Đường dẫn của trang tương ứng ở ngôn ngữ còn lại */
  altHref: string;
}
const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const current = stripLang(Astro.url.pathname).replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: t('nav.home') },
  { href: '/about', label: t('nav.about') },
  { href: '/projects', label: t('nav.projects') },
  { href: '/blog', label: t('nav.blog') },
  { href: '/contact', label: t('nav.contact') },
];
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
const otherLang = lang === 'vi' ? 'en' : 'vi';
---

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-fg focus:px-4 focus:py-2 focus:text-bg">
  {t('nav.skip')}
</a>

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 md:px-6 md:pt-4" data-header>
  <nav
    class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-3 rounded-full border border-line px-3 pl-4 shadow-[var(--shadow)] backdrop-blur-xl transition-[background-color,border-color] duration-300 md:h-16 md:pl-6"
    style="background: var(--nav-bg)"
    aria-label="Main"
  >
    <a href={localize('/', lang)} class="flex shrink-0 items-center gap-2.5" aria-label="Hiếu Vũ Engineering — home">
      <Logo height={26} />
      <span class="hidden font-display text-[0.95rem] font-semibold tracking-tight sm:inline">
        Hiếu Vũ <span class="text-muted">| Engineering</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={localize(l.href, lang)}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'relative whitespace-nowrap rounded-full px-3.5 py-2 text-[0.9rem] font-medium transition-colors',
                isActive(l.href) ? 'text-fg' : 'text-muted hover:text-fg',
              ]}
            >
              {l.label}
              {isActive(l.href) && <span class="absolute inset-x-3.5 -bottom-0.5 h-px bg-accent-bright" aria-hidden="true" />}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1.5">
      <a
        href={altHref}
        hreflang={otherLang}
        lang={otherLang}
        class="inline-flex h-10 min-w-10 items-center justify-center gap-1 rounded-full px-2.5 font-mono text-xs font-semibold uppercase tracking-wider text-muted transition-colors hover:bg-surface-2 hover:text-fg"
        aria-label={t('lang.switch')}
        title={t('lang.switch')}
        data-lang-switch
      >
        <Icon name="globe" size={16} />
        {otherLang}
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-fg"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
        data-theme-toggle
      >
        <Icon name="moon" size={18} class="dark:hidden" />
        <Icon name="sun" size={18} class="hidden dark:block" />
      </button>
      <a href={localize('/contact', lang)} class="btn btn-primary ml-1 hidden !min-h-10 !py-2 !text-sm md:inline-flex">
        {t('nav.cta')}
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-fg transition-colors hover:bg-surface-2 lg:hidden"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </nav>
</header>

<!-- Menu di động -->
<dialog id="mobile-menu" class="m-0 h-dvh max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm lg:hidden" aria-label="Menu">
  <div class="ml-auto flex h-full w-[min(22rem,88vw)] flex-col border-l border-line bg-bg p-5" data-menu-panel>
    <div class="flex items-center justify-between">
      <Logo variant="full" height={34} />
      <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-full hover:bg-surface-2" aria-label={t('nav.close')} data-menu-close>
        <Icon name="x" size={22} />
      </button>
    </div>
    <ul class="mt-10 flex flex-col gap-1">
      {
        links.map((l, i) => (
          <li>
            <a
              href={localize(l.href, lang)}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between rounded-2xl px-4 py-3.5 font-display text-xl font-medium transition-colors hover:bg-surface-2',
                isActive(l.href) ? 'text-accent' : 'text-fg',
              ]}
            >
              <span>
                <span class="mr-3 font-mono text-xs text-muted">0{i + 1}</span>
                {l.label}
              </span>
              <Icon name="arrow-right" size={18} class="text-muted" />
            </a>
          </li>
        ))
      }
    </ul>
    <a href={localize('/contact', lang)} class="btn btn-primary mt-auto w-full">{t('nav.cta')}</a>
  </div>
</dialog>

<script>
  const root = document.documentElement;
  const toggle = () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#070b14' : '#f8fafc');
    window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  };
  document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', toggle));

  // Ghi nhớ lựa chọn ngôn ngữ của người xem
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('lang', a.hreflang); } catch {} }),
  );

  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  openBtn?.addEventListener('click', () => { dialog?.showModal(); openBtn.setAttribute('aria-expanded', 'true'); });
  const close = () => { dialog?.close(); openBtn?.setAttribute('aria-expanded', 'false'); };
  document.querySelector('[data-menu-close]')?.addEventListener('click', close);
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) close(); });
  dialog?.addEventListener('close', () => openBtn?.setAttribute('aria-expanded', 'false'));
</script>
