---
/*
  Trợ lý FAQ (bản khởi đầu, chạy hoàn toàn trên trình duyệt, không gửi dữ liệu đi đâu).
  Giai đoạn sau có thể thay bằng chatbot AI qua /api/chat.
  Chỉnh câu trả lời trong mảng `intents` bên dưới.
*/
import Icon from './Icon.astro';
import { localize, type Lang } from '@/i18n/ui';
import { site } from '@/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (vi: string, en: string) => (lang === 'vi' ? vi : en);
const contact = localize('/contact', lang);

const intents = [
  {
    id: 'services',
    chip: L('Dịch vụ mô phỏng', 'Simulation services'),
    keys: ['dịch vụ', 'dich vu', 'mô phỏng gì', 'service', 'what do you', 'hvac', 'khí động', 'aero', 'nhiệt', 'thermal', 'bơm', 'pump', 'lò hơi', 'đốt', 'boiler', 'combustion', 'nox'],
    answer: L(
      `Tôi nhận mô phỏng năng lượng & đốt cháy (lò hơi, buồng đốt, xử lý khí thải), công nghiệp quá trình, HVAC/Data Center, truyền nhiệt và bơm–quạt bằng Simcenter STAR-CCM+, cùng đội ngũ CFDWAYS. Xem chi tiết tại <a href="${localize('/', lang)}#services">mục Dịch vụ</a>.`,
      `I handle energy & combustion (boilers, furnaces, flue-gas treatment), process equipment, HVAC/data centers, heat transfer and pumps/fans with Simcenter STAR-CCM+, together with the CFDWAYS team. See <a href="${localize('/', lang)}#services">Services</a>.`,
    ),
  },
  {
    id: 'quote',
    chip: L('Báo giá & thời gian', 'Quote & timeline'),
    keys: ['giá', 'gia', 'báo giá', 'chi phí', 'bao lâu', 'thời gian', 'price', 'cost', 'quote', 'how long', 'timeline'],
    answer: L(
      `Chi phí phụ thuộc độ phức tạp hình học, vật lý và số phương án. Hãy gửi mô tả ngắn + file CAD (nếu có) qua <a href="${contact}">form liên hệ</a> — tôi phản hồi trong 24 giờ làm việc với phạm vi và báo giá.`,
      `Cost depends on geometry complexity, physics and number of design variants. Send a short brief + CAD (if any) via the <a href="${contact}">contact form</a> — I reply within one business day with scope and a quote.`,
    ),
  },
  {
    id: 'learn',
    chip: L('Học CFD / STAR-CCM+', 'Learn CFD / STAR-CCM+'),
    keys: ['học', 'hoc', 'khóa', 'đào tạo', 'sinh viên', 'learn', 'course', 'training', 'student', 'tutorial'],
    answer: L(
      `Bạn có thể bắt đầu từ <a href="${localize('/blog', lang)}">chuyên mục Kiến thức</a> và kênh <a href="https://www.youtube.com/@Hieuvuengineering" target="_blank" rel="noopener">YouTube</a>. Nếu cần đào tạo theo nhóm/doanh nghiệp, hãy chọn “Đào tạo” trong form liên hệ.`,
      `Start with the <a href="${localize('/blog', lang)}">Insights section</a> and my <a href="https://www.youtube.com/@Hieuvuengineering" target="_blank" rel="noopener">YouTube channel</a>. For team or corporate training, choose “Training” in the contact form.`,
    ),
  },
  {
    id: 'contact',
    chip: L('Liên hệ trực tiếp', 'Contact directly'),
    keys: ['liên hệ', 'lien he', 'zalo', 'email', 'số điện thoại', 'contact', 'phone', 'call'],
    answer: L(
      `Email: <a href="mailto:${site.email}">${site.email}</a> · Zalo: <a href="https://zalo.me/${site.phone}" target="_blank" rel="noopener">${site.phone}</a> · hoặc <a href="${contact}">đặt lịch trao đổi</a>.`,
      `Email: <a href="mailto:${site.email}">${site.email}</a> · Zalo: <a href="https://zalo.me/${site.phone}" target="_blank" rel="noopener">${site.phone}</a> · or <a href="${contact}">book a call</a>.`,
    ),
  },
];
const fallback = L(
  `Câu hỏi hay! Để trả lời chính xác, bạn nhắn trực tiếp cho tôi qua <a href="https://zalo.me/${site.phone}" target="_blank" rel="noopener">Zalo</a> hoặc <a href="${contact}">form liên hệ</a> nhé.`,
  `Good question! For an accurate answer, please message me on <a href="https://zalo.me/${site.phone}" target="_blank" rel="noopener">Zalo</a> or via the <a href="${contact}">contact form</a>.`,
);
const greeting = L('Xin chào! Tôi là trợ lý của Hiếu. Bạn cần hỗ trợ gì?', 'Hi! I am Hieu’s assistant. How can I help?');
---

<div class="fixed bottom-5 right-5 z-50 md:right-6" data-chat>
  <div
    id="chat-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="chat-title"
    hidden
    class="absolute bottom-16 right-0 flex h-[min(32rem,75dvh)] w-[min(23rem,calc(100vw-2.5rem))] flex-col overflow-hidden rounded-3xl border border-line bg-surface shadow-[0_24px_64px_-16px_rgb(0_0_0/0.45)]"
  >
    <div class="flex items-center justify-between bg-ink px-4 py-3 text-ink-fg">
      <div class="flex items-center gap-3">
        <span class="relative inline-flex h-9 w-9 items-center justify-center rounded-full bg-cyan/15 text-cyan">
          <Icon name="sparkles" size={18} />
          <span class="absolute -right-0.5 -bottom-0.5 h-2.5 w-2.5 rounded-full border-2 border-ink bg-emerald-400"></span>
        </span>
        <div>
          <p id="chat-title" class="font-display text-sm font-semibold">HV Assistant</p>
          <p class="text-xs text-ink-muted">{L('Thường trả lời ngay', 'Usually replies instantly')}</p>
        </div>
      </div>
      <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full hover:bg-white/10" aria-label={L('Đóng trò chuyện', 'Close chat')} data-chat-close>
        <Icon name="x" size={18} />
      </button>
    </div>
    <div class="flex-1 space-y-3 overflow-y-auto p-4 text-sm" data-chat-log aria-live="polite">
      <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-surface-2 px-3.5 py-2.5 text-fg-soft" set:html={greeting} />
    </div>
    <div class="flex flex-wrap gap-1.5 px-4 pb-2" data-chat-chips>
      {intents.map((i) => <button type="button" class="chip hover:border-accent hover:text-accent" data-intent={i.id}>{i.chip}</button>)}
    </div>
    <form class="flex gap-2 border-t border-line p-3" data-chat-form>
      <label for="chat-input" class="sr-only">{L('Nhập câu hỏi', 'Type a question')}</label>
      <input id="chat-input" class="field !min-h-10 !rounded-full !py-2 !text-sm" placeholder={L('Nhập câu hỏi…', 'Type a question…')} autocomplete="off" maxlength="300" />
      <button type="submit" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-cyan text-[#04121a]" aria-label={L('Gửi', 'Send')}>
        <Icon name="send" size={16} />
      </button>
    </form>
  </div>

  <button
    type="button"
    class="relative inline-flex h-14 w-14 items-center justify-center rounded-full bg-ink text-cyan shadow-[0_12px_32px_-8px_rgb(62_214_224/0.5)] ring-1 ring-cyan/30 transition-transform hover:scale-105"
    aria-label={L('Mở trợ lý trò chuyện', 'Open chat assistant')}
    aria-expanded="false"
    aria-controls="chat-panel"
    data-chat-toggle
  >
    <Icon name="chat" size={24} />
  </button>
  <script type="application/json" data-chat-data set:html={JSON.stringify({ intents, fallback })} />
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) {
    const panel = root.querySelector<HTMLElement>('#chat-panel')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-chat-toggle]')!;
    const log = root.querySelector<HTMLElement>('[data-chat-log]')!;
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]')!;
    const input = form.querySelector('input')!;
    const { intents, fallback } = JSON.parse(root.querySelector('[data-chat-data]')!.textContent || '{}') as {
      intents: { id: string; chip: string; keys: string[]; answer: string }[];
      fallback: string;
    };

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) input.focus();
    };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    root.querySelector('[data-chat-close]')!.addEventListener('click', () => { setOpen(false); toggle.focus(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { setOpen(false); toggle.focus(); } });

    const bubble = (html: string, mine = false) => {
      const div = document.createElement('div');
      div.className = mine
        ? 'ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-cyan px-3.5 py-2.5 text-[#04121a]'
        : 'max-w-[85%] rounded-2xl rounded-tl-sm bg-surface-2 px-3.5 py-2.5 text-fg-soft [&_a]:text-accent [&_a]:underline';
      if (mine) div.textContent = html; else div.innerHTML = html;
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    };
    const reply = (html: string) => setTimeout(() => bubble(html), 350);

    root.querySelectorAll<HTMLButtonElement>('[data-intent]').forEach((b) =>
      b.addEventListener('click', () => {
        const it = intents.find((i) => i.id === b.dataset.intent)!;
        bubble(it.chip, true);
        reply(it.answer);
      }),
    );
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      bubble(q, true);
      input.value = '';
      const lower = q.toLowerCase();
      const hit = intents.find((i) => i.keys.some((k) => lower.includes(k)));
      reply(hit ? hit.answer : fallback);
    });
  }
</script>
