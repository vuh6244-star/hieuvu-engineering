/*
  "Connecting CFD Simulation with Digital Engineering" — trang chủ, ngay sau khối 8 ngành.
  Sơ đồ mạch tương tác (SVG, không dùng ảnh): 8 khối hệ thống + chip trung tâm + 2 điểm nghẽn.
  Rê chuột / chạm vào khối → khối sáng lên, các đường mạch nối với nó sáng & chạy dòng, bảng mô tả bên dưới đổi nội dung.
  PC: bảng mạch 3D nhìn thẳng, lưới 4×2 cân đối; mỗi khối mang mô hình 3D thật (hộp, trụ, hình đùn khối) · Điện thoại: lưới 2 cột cùng bộ icon.
*/
import type { Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (vi: string, en: string) => (lang === 'vi' ? vi : en);

/* ---------- bánh răng (dùng trong icon) ---------- */
const gear = (cx: number, cy: number, r: number, n: number) => {
  const pts: string[] = [];
  for (let i = 0; i < n * 2; i++) {
    const a0 = (i / (n * 2)) * Math.PI * 2, a1 = ((i + 1) / (n * 2)) * Math.PI * 2;
    const rr = i % 2 ? r * 0.8 : r;
    pts.push(`${(cx + rr * Math.cos(a0)).toFixed(1)},${(cy + rr * Math.sin(a0)).toFixed(1)}`, `${(cx + rr * Math.cos(a1)).toFixed(1)},${(cy + rr * Math.sin(a1)).toFixed(1)}`);
  }
  return `M${pts.join('L')}Z`;
};

