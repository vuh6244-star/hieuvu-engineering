---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '@/i18n/ui';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---

<button
  type="button"
  class="fixed bottom-5 left-5 z-40 inline-flex h-11 w-11 translate-y-3 items-center justify-center rounded-full border border-line bg-surface text-fg opacity-0 shadow-[var(--shadow)] transition-all duration-300 pointer-events-none hover:border-accent hover:text-accent data-[show]:pointer-events-auto data-[show]:translate-y-0 data-[show]:opacity-100 md:left-6"
  aria-label={t('common.backTop')}
  title={t('common.backTop')}
  data-back-top
>
  <Icon name="chevron-up" size={20} />
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-back-top]');
  if (btn) {
    const onScroll = () => btn.toggleAttribute('data-show', window.scrollY > 900);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    btn.addEventListener('click', () => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      document.getElementById('main')?.focus({ preventScroll: true });
    });
  }
</script>
