---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import portrait from '@/assets/portrait.jpg';
import { site, socials, toolset } from '@/data/site';
import { localize, useTranslations, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (vi: string, en: string) => (lang === 'vi' ? vi : en);

/* ⚠ TODO: cập nhật mốc thời gian, tên trường và chứng chỉ thật */
const timeline = [
  {
    period: L('2024 — Nay', '2024 — Present'),
    title: L('Kỹ sư mô phỏng CFD · Kỹ sư R&D', 'CFD Simulation Engineer · R&D Engineer'),
    org: 'CFDWAYS',
    orgUrl: site.companyUrl[lang],
    desc: L(
      'Thực hiện dự án mô phỏng dòng chảy và truyền nhiệt cho khách hàng công nghiệp; nghiên cứu quy trình mô phỏng mới và hỗ trợ kỹ thuật Simcenter STAR-CCM+ tại CFDWAYS — đối tác phần mềm của Siemens Digital Industries Software.',
      'Delivering flow and heat-transfer simulation projects for industrial clients; developing new simulation workflows and providing Simcenter STAR-CCM+ technical support at CFDWAYS, a Siemens Digital Industries Software partner.',
    ),
    icon: 'briefcase',
  },
  {
    period: '2020 — 2024',
    title: L('Kỹ sư Cơ khí / Kỹ thuật Nhiệt', 'B.Eng. Mechanical / Thermal Engineering'),
    org: L('[Tên trường đại học — cập nhật]', '[University name — update]'),
    orgUrl: undefined as string | undefined,
    desc: L('Nền tảng cơ học chất lưu, truyền nhiệt và phương pháp số. Đồ án tốt nghiệp về mô phỏng CFD.', 'Foundations in fluid mechanics, heat transfer and numerical methods. Thesis on CFD simulation.'),
    icon: 'graduation',
  },
];

const skills = [
  { group: L('Mô phỏng CFD', 'CFD simulation'), items: ['RANS (k-ω SST, k-ε)', 'LES / DES', 'CHT', 'VOF · Eulerian', 'Lagrangian · DEM', 'MRF · RBM · Overset'] },
  { group: L('Lưới & hình học', 'Meshing & geometry'), items: ['Polyhedral · Trimmed', 'Prism layers · y+', 'Surface wrapping', 'Siemens NX CAD'] },
  { group: L('Hệ thống & tối ưu', 'Systems & optimisation'), items: ['Simcenter Amesim (1D)', 'Co-simulation 1D–3D', 'Simcenter FloEFD / FloTherm', 'Design of Experiments'] },
  { group: L('Tự động hóa & báo cáo', 'Automation & reporting'), items: ['Java macro (STAR-CCM+)', 'Python', L('Báo cáo kỹ thuật', 'Technical reports'), L('Video hậu xử lý', 'Post-processing videos')] },
];

const certs = [
  { name: L('Simcenter STAR-CCM+ — [Chứng chỉ, cập nhật]', 'Simcenter STAR-CCM+ — [Certification, update]'), by: 'Siemens Digital Industries Software' },
  { name: L('[Chứng chỉ / giải thưởng khác — cập nhật]', '[Other certificate / award — update]'), by: '—' },
];

const longBio = lang === 'vi'
  ? [
      'Tôi là Hiếu Vũ, kỹ sư mô phỏng CFD và kỹ sư nghiên cứu & phát triển tại CFDWAYS — công ty kỹ thuật mô phỏng tại Hà Nội và là đối tác phần mềm của Siemens Digital Industries Software.',
      'Công việc hằng ngày của tôi là biến những câu hỏi thiết kế — “buồng đốt có thể giảm NOx bao nhiêu?”, “phòng máy chủ có đủ mát khi tăng tải?”, “bơm có bị xâm thực không?” — thành mô hình mô phỏng đáng tin cậy và câu trả lời định lượng.',
      'Tôi làm việc trong hệ sinh thái Siemens Xcelerator: Simcenter STAR-CCM+ cho CFD đa vật lý, Simcenter FloEFD/FloTherm cho bài toán nhiệt, Siemens NX cho hình học và Simcenter Amesim cho mô phỏng hệ thống. Điều tôi theo đuổi là mô phỏng có kiểm chứng: độc lập lưới, kiểm tra hội tụ và đối chiếu thực nghiệm trước khi đưa ra khuyến nghị.',
      'Ngoài dự án, tôi chia sẻ kiến thức CFD qua blog và kênh YouTube để giúp các bạn kỹ sư, sinh viên tiếp cận mô phỏng một cách bài bản.',
    ]
  : [
      'I am Hieu Vu, a CFD simulation engineer and R&D engineer at CFDWAYS — a Hanoi-based simulation engineering company and Siemens Digital Industries Software partner.',
      'My daily work is turning design questions — “how much NOx can this furnace cut?”, “will the server room stay cool under more load?”, “will this pump cavitate?” — into reliable simulation models and quantified answers.',
      'I work within the Siemens Xcelerator ecosystem: Simcenter STAR-CCM+ for multiphysics CFD, Simcenter FloEFD/FloTherm for thermal problems, Siemens NX for geometry and Simcenter Amesim for system simulation. I care about verified simulation: mesh independence, convergence checks and validation before any recommendation.',
      'Beyond projects, I share CFD knowledge through my blog and YouTube channel to help engineers and students approach simulation the right way.',
    ];
---

<BaseLayout
  lang={lang}
  title={L('Giới thiệu — Hiếu Vũ, kỹ sư mô phỏng CFD', 'About — Hieu Vu, CFD simulation engineer')}
  description={L('Tiểu sử, kinh nghiệm, học vấn và kỹ năng mô phỏng CFD của Hiếu Vũ — kỹ sư R&D tại CFDWAYS, chuyên Simcenter STAR-CCM+.', 'Bio, experience, education and CFD skills of Hieu Vu — R&D engineer at CFDWAYS specialising in Simcenter STAR-CCM+.')}
  type="profile"
>
  <section class="bg-grid pb-16 pt-32 md:pt-40">
    <div class="container-x grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHeading as="h1" eyebrow={L('Giới thiệu', 'About')} title={L('Xin chào, tôi là', 'Hello, I am')} strong={site.name + '.'} desc={site.role[lang]} />
        <div class="reveal mt-8 space-y-4 text-lg text-fg-soft">
          {longBio.map((p) => <p>{p}</p>)}
        </div>
        <div class="reveal mt-9 flex flex-wrap gap-3">
          <a href={site.cvUrl} class="btn btn-dark" download><Icon name="download" size={18} /> {t('common.downloadCv')}</a>
          <a href={localize('/contact', lang)} class="btn btn-ghost">{t('nav.contact')} <Icon name="arrow-right" size={18} /></a>
        </div>
        <ul class="reveal mt-8 flex flex-wrap gap-2">
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener" class="chip hover:border-accent hover:text-accent"><Icon name={s.id} size={14} /> {s.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="reveal lg:col-span-5">
        <div class="relative mx-auto max-w-md">
          <div class="absolute -inset-4 rounded-[2.25rem] bg-gradient-to-br from-cyan/30 via-transparent to-brand-blue/30 blur-2xl" aria-hidden="true"></div>
          <Image src={portrait} alt={L('Chân dung Hiếu Vũ', 'Portrait of Hieu Vu')} widths={[400, 640, 900]} sizes="(min-width: 1024px) 28rem, 90vw" class="relative aspect-[4/5] w-full rounded-[2rem] border border-line object-cover object-top" loading="eager" />
          <div class="absolute -bottom-5 -left-3 rounded-2xl border border-line bg-surface px-4 py-3 shadow-[var(--shadow)] md:-left-8">
            <p class="font-mono text-xs text-muted">{L('Hiện tại', 'Currently')}</p>
            <p class="font-semibold text-fg">R&D @ CFDWAYS</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Kinh nghiệm & học vấn -->
  <section class="section border-t border-line" aria-labelledby="journey">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading id="journey" eyebrow={L('Hành trình', 'Journey')} title={L('Kinh nghiệm &', 'Experience &')} strong={L('học vấn.', 'education.')} />
      </div>
      <ol class="relative space-y-10 border-l border-line pl-8 lg:col-span-8">
        {timeline.map((item) => (
          <li class="reveal relative">
            <span class="absolute -left-[3.05rem] top-0 inline-flex h-9 w-9 items-center justify-center rounded-full border border-line bg-surface text-accent"><Icon name={item.icon} size={17} /></span>
            <p class="font-mono text-xs text-accent">{item.period}</p>
            <h3 class="mt-1.5 text-xl font-semibold text-fg">{item.title}</h3>
            <p class="text-fg-soft">{item.orgUrl ? <a href={item.orgUrl} target="_blank" rel="noopener" class="underline decoration-line-strong underline-offset-4 hover:text-accent">{item.org}</a> : item.org}</p>
            <p class="mt-3 text-muted">{item.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Kỹ năng -->
  <section class="section bg-surface-2/50" aria-labelledby="skills">
    <div class="container-x">
      <SectionHeading id="skills" eyebrow={L('Kỹ năng', 'Skills')} title={L('Bộ công cụ', 'Technical')} strong={L('kỹ thuật.', 'toolkit.')} />
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {skills.map((g) => (
          <div class="card reveal p-6">
            <h3 class="font-display text-lg font-semibold text-fg">{g.group}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">{g.items.map((i) => <li class="chip">{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="reveal mt-10 grid gap-4 rounded-[var(--radius-panel)] bg-ink p-6 text-ink-fg sm:grid-cols-2 md:p-8 lg:grid-cols-5">
        {toolset.map((tool) => (
          <div class="border-l border-ink-line pl-4">
            <p class="font-display font-semibold">{tool.name}</p>
            <p class="text-sm text-ink-muted">{tool.role[lang]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chứng chỉ -->
  <section class="section" aria-labelledby="certs">
    <div class="container-x">
      <SectionHeading id="certs" eyebrow={L('Chứng chỉ', 'Certifications')} title={L('Chứng chỉ &', 'Certificates &')} strong={L('ghi nhận.', 'recognition.')} />
      <ul class="mt-10 grid gap-4 md:grid-cols-2">
        {certs.map((c) => (
          <li class="card reveal flex items-center gap-4 p-5">
            <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-ink text-cyan"><Icon name="award" size={22} /></span>
            <div><p class="font-semibold text-fg">{c.name}</p><p class="text-sm text-muted">{c.by}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaPanel lang={lang} />
</BaseLayout>
