---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FlowArt from '@/components/FlowArt.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import portrait from '@/assets/portrait.jpg';
import { blogCategories, site } from '@/data/site';
import { formatDate, localize, useTranslations, type Lang } from '@/i18n/ui';
import { getPosts, hasTranslation, readingTime, slugOf, type Post } from '@/lib/content';

interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const t = useTranslations(lang);
const L = (vi: string, en: string) => (lang === 'vi' ? vi : en);
const d = post.data;
const slug = slugOf(post.id);
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const mins = d.readingTime ?? readingTime(post.body, lang);
const other: Lang = lang === 'vi' ? 'en' : 'vi';
const alternates = {
  [lang]: localize(`/blog/${slug}`, lang),
  [other]: (await hasTranslation('blog', slug, other)) ? localize(`/blog/${slug}`, other) : undefined,
} as { vi?: string; en?: string };
const related = (await getPosts(lang)).filter((p) => p.id !== post.id).slice(0, 3);
const url = new URL(localize(`/blog/${slug}`, lang), site.url).href;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  author: { '@type': 'Person', name: site.name, url: site.url },
  publisher: { '@type': 'Person', name: site.name },
  mainEntityOfPage: url,
  inLanguage: lang,
  keywords: d.tags.join(', '),
};
---

<BaseLayout lang={lang} title={d.title} description={d.description} type="article" publishedTime={d.date} modifiedTime={d.updated} alternates={alternates} jsonLd={ld}>
  <article>
    <header class="pt-28 md:pt-36">
      <div class="container-x max-w-4xl">
        <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href={localize('/blog', lang)} class="hover:text-accent">{t('nav.blog')}</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-accent">{blogCategories[d.category][lang]}</li>
          </ol>
        </nav>
        <h1 class="mt-6 text-[2.2rem] font-semibold leading-[1.1] md:text-[3.4rem]">{d.title}</h1>
        <p class="mt-5 text-lg text-muted">{d.description}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4 border-y border-line py-4">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center overflow-hidden rounded-full bg-ink">
              <Image src={portrait} alt="" width={40} height={40} densities={[1, 2]} class="h-10 w-10 object-cover object-top" />
            </span>
            <div class="text-sm">
              <p class="font-semibold text-fg">{site.name}</p>
              <p class="text-muted">{site.role[lang]}</p>
            </div>
          </div>
          <div class="ml-auto flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
            <span class="inline-flex items-center gap-1.5"><Icon name="calendar" size={14} /><time datetime={d.date.toISOString()}>{formatDate(d.date, lang)}</time></span>
            <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={14} />{mins} {t('common.minRead')}</span>
          </div>
        </div>
      </div>
      <div class="container-x mt-10 max-w-5xl">
        <div class="overflow-hidden rounded-[var(--radius-panel)] border border-line bg-ink">
          {
            d.cover ? (
              <Image src={d.cover} alt={d.coverAlt ?? d.title} widths={[800, 1280]} sizes="(min-width: 1024px) 64rem, 100vw" class="aspect-[16/8] w-full object-cover" loading="eager" />
            ) : (
              <FlowArt variant={d.art} class="aspect-[16/8] w-full" label={d.title} eager />
            )
          }
        </div>
      </div>
    </header>

    <div class="container-x grid max-w-6xl gap-12 py-14 lg:grid-cols-[1fr_15rem] lg:py-16">
      <div class="prose-eng mx-auto w-full lg:mx-0">
        <Content />
      </div>
      <aside class="hidden lg:block">
        <div class="sticky top-28 space-y-8">
          {
            toc.length > 0 && (
              <nav aria-labelledby="toc-title">
                <p id="toc-title" class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-muted">{t('blog.toc')}</p>
                <ol class="mt-4 space-y-2 border-l border-line text-sm">
                  {toc.map((h) => (
                    <li><a href={`#${h.slug}`} class="-ml-px block border-l border-transparent py-0.5 pl-4 text-muted transition-colors hover:border-accent hover:text-fg" data-toc={h.slug}>{h.text}</a></li>
                  ))}
                </ol>
              </nav>
            )
          }
          <div>
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-muted">{t('blog.share')}</p>
            <div class="mt-3 flex gap-2">
              <a class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line text-muted hover:border-accent hover:text-accent" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={16} /></a>
              <a class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line text-muted hover:border-accent hover:text-accent" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={16} /></a>
              <button type="button" class="inline-flex h-10 items-center justify-center gap-1.5 rounded-full border border-line px-3 text-xs font-medium text-muted hover:border-accent hover:text-accent" data-copy={url} data-done={L('Đã chép!', 'Copied!')}>{L('Chép link', 'Copy link')}</button>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="container-x border-t border-line pt-14" aria-labelledby="related-posts">
        <h2 id="related-posts" class="text-2xl font-semibold">{t('blog.related')}</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {related.map((p) => <PostCard post={p} lang={lang} />)}
        </div>
      </section>
    )
  }
  <CtaPanel lang={lang} />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); const old = b.textContent; b.textContent = b.dataset.done!; setTimeout(() => (b.textContent = old), 1600); } catch {}
    }),
  );
  // Đánh dấu mục lục theo vị trí đọc
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
  if (links.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((l) => {
          const on = l.dataset.toc === e.target.id;
          l.classList.toggle('!text-accent', on);
          l.classList.toggle('!border-accent', on);
        });
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    links.forEach((l) => { const h = document.getElementById(l.dataset.toc!); if (h) io.observe(h); });
  }
</script>
