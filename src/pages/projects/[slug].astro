---
import ProjectDetailView from '@/views/ProjectDetailView.astro';
import { getCollection } from 'astro:content';
import { langOf, slugOf } from '@/lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('projects', (e) => langOf(e.id) === 'vi' && (!e.data.draft || import.meta.env.DEV));
  return entries.map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---

<ProjectDetailView project={entry} lang="vi" />
