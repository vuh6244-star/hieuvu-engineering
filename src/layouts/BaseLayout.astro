---
import '@/styles/global.css';
import SEO, { type SEOProps } from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BackToTop from '@/components/BackToTop.astro';
import ChatWidget from '@/components/ChatWidget.astro';
import FloatingSocials from '@/components/FloatingSocials.astro';
import Analytics from '@/components/Analytics.astro';
import { localize, stripLang, type Lang } from '@/i18n/ui';
import { site, socials } from '@/data/site';

type Props = Omit<SEOProps, 'alternates'> & {
  /** Ghi đè đường dẫn bản dịch (ví dụ: bài viết chưa có bản tiếng Anh) */
  alternates?: SEOProps['alternates'];
};

const props = Astro.props as Props;
const lang: Lang = props.lang;
const basePath = stripLang(Astro.url.pathname).replace(/\/$/, '') || '/';
const alternates = props.alternates ?? { vi: localize(basePath, 'vi'), en: localize(basePath, 'en') };
const otherLang: Lang = lang === 'vi' ? 'en' : 'vi';
const altHref = alternates[otherLang] ?? localize('/', otherLang);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.nameAscii,
  url: site.url,
  image: new URL('/og-default.png', site.url).href,
  jobTitle: site.role[lang],
  email: `mailto:${site.email}`,
  worksFor: { '@type': 'Organization', name: site.company, url: site.companyUrl.vi },
  knowsAbout: ['Computational Fluid Dynamics', 'Simcenter STAR-CCM+', 'Combustion', 'Heat transfer', 'Process engineering', 'HVAC', 'Turbomachinery'],
  sameAs: socials.filter((s) => s.id !== 'zalo').map((s) => s.href),
};
const extraLd = props.jsonLd ? (Array.isArray(props.jsonLd) ? props.jsonLd : [props.jsonLd]) : [];
---

<!doctype html>
<html lang={lang} data-theme="dark" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#070b14" />
    <meta name="color-scheme" content="light dark" />
    <!-- Áp dụng giao diện sáng/tối trước khi vẽ trang để tránh nháy màu -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        d.dataset.theme = t;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'dark' ? '#070b14' : '#f8fafc');
      })();
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...props} alternates={alternates} jsonLd={[personLd, ...extraLd]} />
    <Analytics lang={lang} />
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <Header lang={lang} altHref={altHref} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
    <BackToTop lang={lang} />
    <FloatingSocials lang={lang} />
    <ChatWidget lang={lang} />

    <script>
      // Hiệu ứng xuất hiện khi cuộn (tôn trọng prefers-reduced-motion qua CSS)
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
